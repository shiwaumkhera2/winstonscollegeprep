# Copy to `.env.local` for local development. All values are optional.

# Static form service endpoint for the contact form.
#   Formspree:  https://formspree.io/f/<your-form-id>
#   Web3Forms:  https://api.web3forms.com/submit  (also set VITE_WEB3FORMS_KEY)
# Leave empty to fall back to opening the visitor's email app (mailto:).
VITE_FORM_ENDPOINT=

# Only needed when using Web3Forms.
VITE_WEB3FORMS_KEY=

# Where the site is served from. The deploy workflow sets both automatically from the
# repository's Pages settings, so you normally never need these. Defaults (for local builds)
# match the project URL: base "/winstonscollegeprep/" at https://shiwaumkhera2.github.io.
# Once the custom domain is configured in Settings → Pages, the workflow switches to
# base "/" and https://winstoncollegeprep.net on its own.
VITE_BASE_PATH=/winstonscollegeprep/
VITE_SITE_URL=https://shiwaumkhera2.github.io/winstonscollegeprep
